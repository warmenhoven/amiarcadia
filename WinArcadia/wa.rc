IDD_SPEED_PIPBUG DIALOG DISCARDABLE  0, 0, 311, 154
STYLE DS_MODALFRAME | DS_CENTERMOUSE | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
CAPTION "Adjust Speed"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Slider2",IDC_ADJUSTSPEED,"msctls_trackbar32",
                    TBS_AUTOTICKS | TBS_TOP | WS_TABSTOP,17,29,143,24
    LTEXT           "25%",IDC_STATIC,16,18,32,11
    RTEXT           "800%",IDC_STATIC,128,18,32,11
    CONTROL         "1 Hz",IDC_CLOCKSPEED_1ST,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP | WS_TABSTOP,222,20,63,10
    ICON            IDI_PIPBUG,IDL_CLOCKSPEEDGLYPH,248,125,20,20
    CONTROL         "1 MHz",IDC_CLOCKSPEED_2ND,"Button",BS_AUTORADIOBUTTON | 
                    WS_TABSTOP,222,31,63,10
    GROUPBOX        "Clock Speed",IDL_CLOCKSPEED,214,5,89,51
    GROUPBOX        "Emulation Speed",IDL_EMUSPEED,9,5,198,51
    CONTROL         "Slider2",IDC_FRAMESKIP,"msctls_trackbar32",
                    TBS_AUTOTICKS | TBS_TOP | WS_TABSTOP,17,84,144,24
    LTEXT           "1/1",IDC_STATIC,17,75,32,11
    RTEXT           "1/10",IDC_STATIC,114,75,32,11
    GROUPBOX        "Frame Skipping",IDL_FRAMESKIP,9,63,198,85
    GROUPBOX        "Baud Rate",IDL_BAUDRATE,214,63,89,55
    CONTROL         "110",IDC_PIPBUG_110BAUD,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP | WS_TABSTOP,222,77,63,10
    CONTROL         "300",IDC_PIPBUG_300BAUD,"Button",BS_AUTORADIOBUTTON | 
                    WS_TABSTOP,222,89,63,10
    CONTROL         "4800",IDC_PIPBUG_4800BAUD,"Button",BS_AUTORADIOBUTTON | 
                    WS_TABSTOP,222,101,63,10
    CTEXT           "100%",IDC_STATIC,57,18,32,11
