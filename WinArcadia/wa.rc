        MENUITEM "&Gaming Guide...",            ID_HELP_GAMINGGUIDE
        MENUITEM "&Manual...",                  ID_HELP_MANUAL
        MENUITEM SEPARATOR
        MENUITEM "Check for &updates...",       ID_HELP_UPDATE
        MENUITEM SEPARATOR
        MENUITEM "&About WinArcadia...\tCtrl+Shift+/", ID_HELP_ABOUT
    END
    MENUITEM "&RetroAchievements",          ID_EMULATOR_CHEEVOS
END

IDR_TRAYMENU_POL MENU DISCARDABLE 
BEGIN
    POPUP "Menu"
    BEGIN
        MENUITEM "Paused?",                     ID_SPEED_PAUSED
        MENUITEM SEPARATOR
        MENUITEM "Uniconify",                   ID_FILE_UNICONIFY
        MENUITEM "Exit",                        ID_FILE_EXIT
    END
END


