/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_ICON                ICON    DISCARDABLE     "icon.ico"
IDI_ARCADIA             ICON    DISCARDABLE     "arcadia.ico"
IDI_INTERTON            ICON    DISCARDABLE     "interton.ico"
IDI_ELEKTOR             ICON    DISCARDABLE     "elektor.ico"
IDI_PIPBUG              ICON    DISCARDABLE     "pipbug.ico"
IDI_INSTRUCTOR          ICON    DISCARDABLE     "instruct.ico"
IDI_CD2650              ICON    DISCARDABLE     "cd2650.ico"
IDI_ASTROWARS           ICON    DISCARDABLE     "astrowar.ico"
IDI_GALAXIA             ICON    DISCARDABLE     "galaxia.ico"
IDI_MALZAK              ICON    DISCARDABLE     "malzak.ico"
IDI_FOLDER              ICON    DISCARDABLE     "folder.ico"
IDI_ROOT                ICON    DISCARDABLE     "root.ico"
IDI_PHUNSY              ICON    DISCARDABLE     "phunsy.ico"
IDI_PARENT              ICON    DISCARDABLE     "parent.ico"
IDI_PONG                ICON    DISCARDABLE     "pong.ico"
IDI_LASERBATTLE         ICON    DISCARDABLE     "laserbat.ico"
IDI_SELBST              ICON    DISCARDABLE     "selbst.ico"
